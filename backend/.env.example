# Local development: copy this file to backend/.env and replace both placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
GATEKEEPER_URL=http://localhost:4000
GATEKEEPER_USERNAME=Fabrice
ADMIN_PASSWORD=replace-with-your-own-long-password
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_AUTH_SECRET=replace-with-a-random-64-character-hex-secret
PROTECTED_APPS='[{"id":"demo","name":"Demo app","url":"http://localhost:3000"}]'
SESSION_TTL_HOURS=168
DATABASE_PATH=database.sqlite
TRUST_PROXY=loopback
# Optional Vite development server; normal startup serves the frontend build.
# DEV_UI_ORIGIN=http://127.0.0.1:5173
# Production uses HTTPS + a common parent domain you own:
# NODE_ENV=production
# GATEKEEPER_URL=https://login.example.com
# COOKIE_DOMAIN=example.com
# PROTECTED_APPS='[{"id":"notes","name":"Notes","url":"https://notes.example.com"}]'
# TRUST_PROXY=172.20.0.2/32
