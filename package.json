{
  "name": "gatekeeper",
  "private": true,
  "version": "2.0.0",
  "description": "Personal single-user authentication gateway",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "dev": "node --watch backend/server.js",
    "test": "npm test --prefix backend && node --test integration/demo-app.test.js",
    "lint": "npm run lint --prefix frontend",
    "demo": "node --env-file=backend/.env integration/demo-app.js",
    "password:set": "npm run password:set --prefix backend"
  }
}
